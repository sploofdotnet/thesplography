---
import { Font } from 'astro:assets';

import { AUDIO_BASE } from '../config';

import bg from '../assets/bg2.png'

import Navigation from '../components/Navigation.astro';

const pageTitle = "updates";
---



<Navigation />
	
	<head>
		<style define:vars={{bg: `url(${bg.src})`}}>
			h1 {
				color:cornflowerblue;
				font-size: 3rem;
				font-family: var(--font-pop-happiness);
			}

			h3 {
				color:antiquewhite;
				font-family: var(--font-pop-happiness);
			}

			p {
				color:blanchedalmond;
				font-family: var(--font-pop-happiness);
			}

			li {
				color:slategray;
				font-family: var(--font-pop-happiness);
			}
			a {
				color:darkgoldenrod;
				font-family: var(--font-pop-happiness);
			}
			body{
				background-image: var(--bg);
			}
		</style>
		<Font cssVariable="--font-pop-happiness"/>
		<meta charset=" utf-8"/>
		<title>{pageTitle}</title>
		</head>
	<body>
		<h1>{pageTitle}</h1>
		<ul>
			<li><a href="/updates/update-1/">update 1</a></li>
		</ul>
	</body>
</html>